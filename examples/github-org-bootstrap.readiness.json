{
  "$schema": "../schemas/readiness-config.v0.schema.json",
  "schema_version": "v0",
  "name": "github-org-bootstrap",
  "description": "Baseline local readiness checks for a new GitHub organization release/signing asset set.",
  "mode": "artifact",
  "sensitivity_floor": "5-privileged",
  "allow_software_keys": true,
  "hardware_preferred": true,
  "hardware_required": false,
  "require_strong_passphrase_attestation": true,
  "capabilities": [
    {
      "id": "gpg-release-sign",
      "provider": "gpg",
      "verb": "sign",
      "description": "Release signing with protected OpenPGP secret signing material.",
      "accepted_material": [
        "protected-secret-key",
        "hardware-backed-key"
      ],
      "require_public_counterpart": true,
      "require_revocation_certificate": true,
      "static_checks": [
        "material-present",
        "not-plaintext",
        "public-counterpart",
        "revocation-present"
      ],
      "proof_checks": [
        "sign-and-verify"
      ]
    },
    {
      "id": "minisign-release-sign",
      "provider": "minisign",
      "verb": "sign",
      "description": "Release signing with encrypted minisign signing material.",
      "accepted_material": [
        "encrypted-private-key",
        "hardware-backed-key"
      ],
      "require_public_counterpart": true,
      "static_checks": [
        "material-present",
        "not-plaintext",
        "public-counterpart"
      ],
      "proof_checks": [
        "sign-and-verify"
      ]
    },
    {
      "id": "ssh-github-auth",
      "provider": "ssh",
      "verb": "auth",
      "description": "SSH authentication material for GitHub access.",
      "accepted_material": [
        "encrypted-private-key",
        "hardware-backed-key"
      ],
      "require_public_counterpart": true,
      "static_checks": [
        "material-present",
        "not-plaintext",
        "public-counterpart"
      ],
      "proof_checks": [
        "derive-public-key"
      ]
    }
  ]
}
