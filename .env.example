# Decernor Environment Variables
# Copy this file to .env for local development
# All variables are optional with sensible defaults

# Logging
DECERNOR_LOG_LEVEL=info                     # trace|debug|info|warn|error

# Configuration
DECERNOR_CONFIG_PATH=~/.config/3leaps/decernor.yaml  # Path to config file (optional)

# Example application-specific variables
# DECERNOR_MAX_DEPTH=10                      # Default max depth for file traversal
# DECERNOR_EXCLUDE_PATTERNS=.git/,vendor/    # Default exclude patterns
